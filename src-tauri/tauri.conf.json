{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "asdf",
	"version": "0.2.0",
	"identifier": "tools.buzzle.asdf",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "asdf",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNEU4RDM3RENGNjNFQTMKUldTalB2YmNONDFPZjh0NVJmQXU2T0doMTRsT3ZIS0JTVXdUTFhaMkd3bWgzMWpkMys4WTA0c2MK",
			"endpoints": [
				"https://github.com/teamBuzzle/asdf/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}

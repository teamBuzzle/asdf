{
	"name": "goldeye",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"prepare": "husky",
		"rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2",
		"@tiptap/pm": "^3.31.0",
		"@tiptap/react": "^3.31.0",
		"@tiptap/starter-kit": "^3.31.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^26.4.1",
		"immer": "^11.1.18",
		"lucide-react": "^1.39.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.13",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"ts-pattern": "^5.9.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.4.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"lint-staged": "^17.4.1",
		"shadcn": "^4.19.1",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@biomejs/biome"
		]
	}
